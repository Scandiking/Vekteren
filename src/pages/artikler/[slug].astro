---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const artikler = await getCollection('artikler');
  return artikler.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { title, description, publishDate, image } = entry.data;

const site = Astro.site ?? new URL('https://vekteren.xyz');
// Trailing slash matches the canonical link, sitemap and RSS.
const articleUrl = new URL(`/artikler/${entry.slug}/`, site).href;

// Structured data so search engines can show headline, date and author.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  author: { '@type': 'Person', name: siteConfig.authorName, url: new URL('/om/', site).href },
  publisher: { '@type': 'Organization', name: 'Vekteren', url: site.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  image: new URL(image?.src ?? '/og-default.png', site).href,
  inLanguage: 'nb-NO',
};
// Escape "<" so article text can never close the script tag early.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

// A table of contents only earns its space on longer articles.
const TOC_MIN_SECTIONS = 5;
const tocHeadings = headings.filter(h => h.depth === 2);
const showToc = tocHeadings.length >= TOC_MIN_SECTIONS;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishDate={publishDate}
  image={image?.src}
  imageAlt={image?.alt}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdHtml} />

  <article class="bg-white dark:bg-gray-950">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

      <!-- Back link -->
      <a href="/artikler" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-orange-500 transition-colors mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Alle artikler
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          {entry.data.tags.map((tag: string) => (
            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 dark:bg-orange-500/15 text-orange-600 dark:text-orange-400">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white leading-tight mb-4">
          {entry.data.title}
        </h1>

        <p class="text-xl text-gray-500 dark:text-gray-400 leading-relaxed mb-6">
          {entry.data.description}
        </p>

        <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
          <span>Kris</span>
          <span>·</span>
          <time datetime={entry.data.publishDate.toISOString()}>
            {entry.data.publishDate.toLocaleDateString('nb-NO', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>
      </header>

      {entry.data.image && (
        <figure class="mb-10 -mx-4 sm:-mx-6">
          <img
            src={entry.data.image.src}
            alt={entry.data.image.alt}
            class="w-full rounded-lg object-cover max-h-96"
            loading="lazy"
          />
          <figcaption class="mt-2 px-4 sm:px-6 text-xs text-gray-500 dark:text-gray-400">
            {entry.data.image.credit}
          </figcaption>
        </figure>
      )}

      <div class="border-t border-gray-200 dark:border-gray-800 pt-10">
        {showToc && (
          <nav aria-labelledby="toc-heading" class="max-w-prose mb-10 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-5">
            <h2 id="toc-heading" class="text-xs uppercase tracking-widest font-semibold text-gray-500 dark:text-gray-400 mb-3">
              Innhold
            </h2>
            <ol class="space-y-1.5 text-sm list-decimal list-inside marker:text-gray-400 dark:marker:text-gray-500">
              {tocHeadings.map(h => (
                <li>
                  <a href={`#${h.slug}`} class="text-gray-700 dark:text-gray-300 hover:text-orange-500 transition-colors">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="prose prose-gray dark:prose-invert prose-lg max-w-prose prose-headings:scroll-mt-24">
          <Content />
        </div>
      </div>

      <!-- Back link (bottom) -->
      <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
        <a href="/artikler" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-orange-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Tilbake til alle artikler
        </a>
      </div>
    </div>
  </article>

</BaseLayout>
