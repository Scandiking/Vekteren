---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL for the social preview image. Falls back to a site-wide image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
}

const {
  title,
  description = 'Vektnedgang som faktisk fungerer. Ingen mirakelkurer – bare kalorier, tålmodighet og riktig mat.',
  image = '/og-default.png',
  imageAlt = 'Vekteren – vektnedgang som faktisk fungerer',
  type = 'website',
  publishDate,
} = Astro.props;

const site = Astro.site ?? new URL('https://vekteren.xyz');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const fullTitle = `${title} | Vekteren`;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Vekteren RSS Feed" href="/rss.xml" />

    <!-- Open Graph / social previews (Facebook, Messenger, Slack, etc.) -->
    <meta property="og:site_name" content="Vekteren" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />

    <!-- Run before first paint to avoid theme flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1077891715359464"
     crossorigin="anonymous"></script>

    <!-- OneSignal Web Push -->
    <script defer src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"></script>
    <script is:inline define:vars={{ appId: import.meta.env.PUBLIC_ONESIGNAL_APP_ID }}>
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      if (appId) {
        OneSignalDeferred.push(async function (OneSignal) {
          await OneSignal.init({ appId });
        });
      }
    </script>

  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
